---
apiVersion: v1
kind: Namespace
metadata:
  name: devops
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: jenkins-agent
  namespace: devops
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: jenkins-agent-cluster-admin-binding
subjects:
- kind: ServiceAccount
  name: jenkins-agent
  namespace: devops
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io
